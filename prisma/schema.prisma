generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

enum CourseType {
  ONE_ON_ONE
  SMALL_CLASS
}

enum SessionStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  LEAVE
  ABSENT
}

enum DeductionReason {
  PRESENT
  ABSENT
}

enum MaterialKind {
  TEXT
  LINK
}

enum MemoryKind {
  AVAILABILITY
  NOTE
}

enum AgentRunStatus {
  OK
  ERROR
}

enum ProposalStatus {
  pending
  confirmed
  executed
  failed
  discarded
}

enum ProposalType {
  CREATE_COURSE
  CREATE_SESSIONS
  ADD_CONTENT
  MARK_ATTENDANCE
  RESCHEDULE
  PROGRESS_RECORD
  STUDENT_REQUEST
  ADD_STUDENT_NOTE
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  role         Role
  passwordHash String

  courses          Course[]
  enrollments      Enrollment[]
  sessionChanges   SessionChange[]
  attendance       Attendance[]    @relation("StudentAttendance")
  markedAttendance Attendance[]    @relation("MarkedAttendance")
  deductions       Deduction[]
  agentRuns        AgentRun[]
  agentProposals   AgentProposal[]
  studentMemories  AgentMemory[]   @relation("StudentMemories")
  teacherMemories  AgentMemory[]   @relation("TeacherMemories")
}

model Course {
  id                   String     @id @default(cuid())
  teacherId            String
  name                 String
  subject              String
  type                 CourseType
  location             String?
  description          String?
  pricePerSessionCents Int        @default(0)

  teacher        User            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments    Enrollment[]
  sessions       Session[]
  deductions     Deduction[]
  units          CourseUnit[]
  agentProposals AgentProposal[]
  agentMemories  AgentMemory[]
}

model Enrollment {
  id        String @id @default(cuid())
  courseId  String
  studentId String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([courseId, studentId])
}

model Session {
  id              String        @id @default(cuid())
  courseId        String
  startAt         DateTime      @db.Timestamptz(3)
  durationMin     Int
  location        String?
  linkUrl         String?
  status          SessionStatus @default(SCHEDULED)
  originalStartAt DateTime?     @db.Timestamptz(3)

  course     Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  changes    SessionChange[]
  attendance Attendance[]
  deductions Deduction[]

  @@index([courseId, startAt])
}

model SessionChange {
  id          String        @id @default(cuid())
  sessionId   String
  changedById String
  fromStatus  SessionStatus
  toStatus    SessionStatus
  oldStartAt  DateTime?     @db.Timestamptz(3)
  newStartAt  DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  changedBy   User          @relation(fields: [changedById], references: [id], onDelete: Restrict)
}

model Attendance {
  id         String           @id @default(cuid())
  sessionId  String
  studentId  String
  status     AttendanceStatus
  markedById String
  markedAt   DateTime         @default(now()) @db.Timestamptz(3)
  session    Session          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student    User             @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Restrict)
  markedBy   User             @relation("MarkedAttendance", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
}

model Deduction {
  id          String          @id @default(cuid())
  sessionId   String
  studentId   String
  courseId    String
  amountCents Int
  reason      DeductionReason
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  session     Session         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student     User            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
}

model CourseUnit {
  id        String     @id @default(cuid())
  courseId  String
  title     String
  order     Int
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  materials Material[]
}

model Material {
  id      String       @id @default(cuid())
  unitId  String
  title   String
  kind    MaterialKind
  content String?
  url     String?
  unit    CourseUnit   @relation(fields: [unitId], references: [id], onDelete: Restrict)
}

model AgentRun {
  id            String         @id @default(cuid())
  actorId       String
  role          Role
  intentSummary String
  toolCalls     Json
  status        AgentRunStatus
  error         String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  actor         User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
}

model AgentProposal {
  id          String         @id @default(cuid())
  type        ProposalType
  actorId     String
  courseId    String?
  payload     Json
  summary     String
  status      ProposalStatus @default(pending)
  result      Json?
  error       String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  confirmedAt DateTime?      @db.Timestamptz(3)
  executedAt  DateTime?      @db.Timestamptz(3)
  actor       User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: Restrict)
}

model AgentMemory {
  id        String     @id @default(cuid())
  courseId  String
  studentId String
  teacherId String
  kind      MemoryKind
  content   String     @db.VarChar(500)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  student   User       @relation("StudentMemories", fields: [studentId], references: [id], onDelete: Restrict)
  teacher   User       @relation("TeacherMemories", fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([teacherId, studentId])
}
